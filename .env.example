# Flask
FLASK_ENV=development
SECRET_KEY=change-this-development-secret

# Database
# Default Phase 1 database: SQLite
DATABASE_URL=sqlite:///financial_fraud.db

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/financial_fraud

# Dataset directories
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Application
HOST=127.0.0.1
PORT=5000
DEBUG=true
